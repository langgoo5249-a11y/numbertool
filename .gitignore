# 依赖
node_modules/

# 构建产物
/dist
/.astro

# 构建时生成的图片资源（由 scripts/ 在 prebuild 阶段产出，不入库）
/public/og-default.png
/public/favicon.svg
/public/favicon.ico
/public/favicon-*.png
/public/apple-touch-icon.png
/public/maskable-icon.png

# 编辑器与系统文件
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# 日志与环境变量
logs
*.log
npm-debug.log*
.env
.env.local

# 构建报告（由 build.mjs 生成）
/build-report.txt
