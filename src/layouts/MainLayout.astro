---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Meta from '../components/seo/Meta.astro';
import WeChatQRPopup from '../components/WeChatQRPopup.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  locale?: 'zh-CN' | 'en-US';
  buildSchema?: 'organization' | 'website' | 'softwareList' | 'none';
  noindex?: boolean;
  extraSchema?: any[];
  type?: 'website' | 'article' | 'faq';
  datePublished?: string;
  dateModified?: string;
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  keywords = '号码标记清除,号码标记查询,号码标记清除网,号码认证,骚扰电话标记,号码归属地查询',
  locale = 'zh-CN',
  buildSchema = 'website',
  noindex = false,
  extraSchema = [],
  type = 'website',
  datePublished,
  dateModified,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Meta
      title={title}
      description={description}
      keywords={keywords}
      locale={locale}
      buildSchema={buildSchema}
      noindex={noindex}
      extraSchema={extraSchema}
      type={type}
      datePublished={datePublished}
      dateModified={dateModified}
    />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-gray-50">
    <a href="#main-content" class="skip-link">跳到主要内容</a>
    <Header locale={locale} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <!-- 微信服务号二维码弹窗（新用户 2 秒后弹出，之后每 24 小时一次） -->
    <WeChatQRPopup />
    <script>
      // 滚动进入视口时触发 reveal 动画
      const revealEls = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      // 回到顶部按钮
      const backToTop = document.getElementById('back-to-top');
      if (backToTop) {
        const toggle = () => {
          const show = window.scrollY > 480;
          backToTop.classList.toggle('opacity-0', !show);
          backToTop.classList.toggle('translate-y-4', !show);
          backToTop.classList.toggle('pointer-events-none', !show);
        };
        window.addEventListener('scroll', toggle, { passive: true });
        toggle();
        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // 头部滚动加深阴影
      const header = document.querySelector('.site-header');
      if (header) {
        const onScroll = () => {
          header.classList.toggle('shadow-md', window.scrollY > 8);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    </script>
  </body>
</html>
