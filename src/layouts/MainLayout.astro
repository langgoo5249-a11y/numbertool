---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Meta from '../components/seo/Meta.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  locale?: 'zh-CN' | 'en-US';
  buildSchema?: 'organization' | 'website' | 'softwareList' | 'none';
  noindex?: boolean;
  extraSchema?: any[];
  type?: 'website' | 'article' | 'faq';
  datePublished?: string;
  dateModified?: string;
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  keywords = '号码标记清除,号码标记查询,号码标记清除网,号码认证,骚扰电话标记,号码归属地查询',
  locale = 'zh-CN',
  buildSchema = 'website',
  noindex = false,
  extraSchema = [],
  type = 'website',
  datePublished,
  dateModified,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <Meta
      title={title}
      description={description}
      keywords={keywords}
      locale={locale}
      buildSchema={buildSchema}
      noindex={noindex}
      extraSchema={extraSchema}
      type={type}
      datePublished={datePublished}
      dateModified={dateModified}
    />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-gray-50">
    <Header locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      // 滚动进入视口时触发 reveal 动画
      const revealEls = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>