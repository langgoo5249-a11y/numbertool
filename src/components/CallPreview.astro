---
/**
 * 来电标记状态示意卡片
 * 用 CSS 绘制手机来电界面（不伪造真实截图，示意性质，页面有明确说明）
 * 用途：直观展示"被标记的来电"长什么样，帮助用户识别自己的处境
 */
interface Props {
  /** 号码显示 */
  number?: string;
  /** 标记名称 */
  label?: string;
  /** 被标记（红）/ 已认证（绿） */
  variant?: 'marked' | 'verified';
}
const {
  number = '138 0013 8000',
  label = '骚扰电话（疑似营销）',
  variant = 'marked',
} = Astro.props;
---

<div class="mx-auto w-64 rounded-[2rem] border-8 border-gray-900 bg-gray-900 shadow-2xl overflow-hidden select-none" role="img" aria-label={`来电界面示意：${label}`}>
  <!-- 状态栏 -->
  <div class="bg-gray-900 text-white/70 text-[10px] flex justify-between px-4 pt-1.5 pb-1">
    <span>9:41</span>
    <span class="flex gap-1 items-center">
      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 20h3v-6H2v6zm5 0h3V9H7v11zm5 0h3v-9h-3v9zm5 0h3V5h-3v15z"/></svg>
      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8c-3.31 0-6.02 2.53-6.02 5.66 0 1.04.3 2.03.83 2.88L6 20l3.68-.9c.77.28 1.6.44 2.47.44 3.31 0 6.02-2.53 6.02-5.66S15.31 8 12 8z" opacity=".4"/><path d="M17.5 5.5C15.9 4 13.9 3 11.6 3 7.4 3 4 6.4 4 10.4c0 .5.06 1 .17 1.4l1.4-1.3C5.6 8 8.2 5.5 11.6 5.5c1.7 0 3.2.7 4.4 1.8l1.5-1.8z"/><path d="M17.5 5.5C16.1 4.1 14.2 3.3 12 3.3c-1 0-1.9.2-2.8.5l1.1 1.7c.5-.2 1.1-.3 1.7-.3 1.8 0 3.4.7 4.6 1.9l.9-1.6z"/><path d="M12 24a12 12 0 100-24 12 12 0 000 24z"/></svg>
    </span>
  </div>

  <!-- 来电主体 -->
  <div class={`relative px-4 pt-6 pb-8 text-center ${variant === 'marked' ? 'bg-gray-100' : 'bg-emerald-50'}`}>
    <div class="text-[11px] text-gray-400 mb-3">来电</div>
    <!-- 号码 + 标记 -->
    {variant === 'marked' ? (
      <div>
        <div class="text-lg font-bold text-gray-900 tabular-nums">{number}</div>
        <div class="mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-100 text-red-600 text-xs font-semibold">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          {label}
        </div>
        <div class="mt-3 text-[10px] text-gray-400">已有 2.1 万人标记</div>
      </div>
    ) : (
      <div>
        <div class="text-lg font-bold text-gray-900 tabular-nums">{number}</div>
        <div class="mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-600 text-xs font-semibold">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.506 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.506 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.506 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.506 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.506 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.506 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.506-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.506-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
          {label}
        </div>
        <div class="mt-3 text-[10px] text-emerald-500">号码认证 · 官方企业名片</div>
      </div>
    )}

    <!-- 接听/挂断 -->
    <div class="flex justify-center gap-12 mt-6">
      <button type="button" class="w-12 h-12 rounded-full bg-gray-300/60 flex items-center justify-center pointer-events-none" aria-hidden="true">
        <span class="text-gray-500 text-lg">✕</span>
      </button>
      <button type="button" class={`w-12 h-12 rounded-full flex items-center justify-center pointer-events-none ${variant === 'marked' ? 'bg-emerald-500' : 'bg-emerald-500'}`} aria-hidden="true">
        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
      </button>
    </div>
  </div>
</div>
