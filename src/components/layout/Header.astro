---
interface Props {
  locale?: 'zh-CN' | 'en-US';
}

const { locale = 'zh-CN' } = Astro.props;

const navLinks = [
  { href: '/zh-CN/tools/marking-clear/', label: '标记清除', section: 'tools' },
  { href: '/zh-CN/tools/marking-check/', label: '标记自查', section: 'tools' },
  { href: '/zh-CN/tools/attribution/', label: '归属地', section: 'tools' },
  { href: '/zh-CN/guide/what-is-number-marking/', label: '指南', section: 'content' },
  { href: '/zh-CN/blog/', label: '号码百科', section: 'content' },
  { href: '/zh-CN/faq/', label: '常见问题', section: 'content' },
  { href: '/zh-CN/compare/marking-platforms/', label: '对比评测', section: 'content' },
];

// 折叠成两组：工具 / 更多
const primaryNav = navLinks.filter((n) => n.section === 'tools');
const contentNav = navLinks.filter((n) => n.section === 'content');
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="主导航">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <a href="/zh-CN/" class="flex items-center space-x-2" aria-label="号码标记清除网 首页">
        <div class="w-9 h-9 bg-gradient-to-br from-blue-600 to-indigo-700 rounded-lg flex items-center justify-center shadow-sm">
          <span class="text-white font-bold text-sm">清</span>
        </div>
        <span class="text-lg font-bold text-gray-900 tracking-tight">号码标记清除网</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center space-x-6">
        <div class="flex items-center space-x-1">
          {primaryNav.map((n) => (
            <a href={n.href} class="text-sm font-medium text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md transition-colors">{n.label}</a>
          ))}
        </div>
        <div class="flex items-center space-x-1 border-l border-gray-200 pl-4">
          {contentNav.map((n) => (
            <a href={n.href} class="text-sm font-medium text-gray-600 hover:text-blue-600 px-2.5 py-2 rounded-md transition-colors">{n.label}</a>
          ))}
        </div>

        <a href="/zh-CN/tools/marking-clear/" class="inline-flex items-center bg-blue-600 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
          立即清除标记
        </a>
      </div>

      <!-- Mobile Menu Toggle -->
      <details class="lg:hidden relative">
        <summary class="p-2 cursor-pointer list-none" aria-label="打开菜单">
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>
        <div class="absolute right-0 top-12 w-56 bg-white border border-gray-200 rounded-xl shadow-lg p-3 space-y-1">
          {[...primaryNav, ...contentNav].map((n) => (
            <a href={n.href} class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded-lg">{n.label}</a>
          ))}
          </div>
      </details>
    </div>
  </nav>
</header>