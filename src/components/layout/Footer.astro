---
import { CLEAR_LINK, VERIFY_LINK, EXTERNAL_PROPS } from '@lib/links';

interface Props {
  locale?: 'zh-CN' | 'en-US';
}

const { locale = 'zh-CN' } = Astro.props;
const L = (zh: string, en: string) => (locale === 'en-US' ? en : zh);

// 核心服务入口（清除/核验为站外快速入口）
const toolLinks = [
  { href: CLEAR_LINK, label: '号码标记清除', external: true },
  { href: '/zh-CN/tools/marking-check/', label: '号码标记自查', external: false },
  { href: '/zh-CN/tools/attribution/', label: '号码归属地查询', external: false },
  { href: '/zh-CN/tools/number-auth/', label: '号码认证服务', external: false },
  { href: VERIFY_LINK, label: '法人号码核验', external: true },
  { href: '/zh-CN/tools/registration-card/', label: '注册卡办理', external: false },
  { href: '/zh-CN/tools/sim-cards/', label: '选号比价', external: false },
];

const guideLinks = [
  { href: '/zh-CN/guide/what-is-number-marking/', label: '号码标记是什么' },
  { href: '/zh-CN/guide/how-to-check-marking/', label: '如何查询号码被标记' },
  { href: '/zh-CN/guide/how-to-clear-marking/', label: '如何清除号码标记' },
  { href: '/zh-CN/guide/landline-marking-clear/', label: '座机号码标记清除' },
  { href: '/zh-CN/guide/what-is-number-auth/', label: '号码认证是什么' },
];

const resourceLinks = [
  { href: 'https://www.opene164.org.cn', label: '中国信通院码号服务', external: true },
  { href: 'https://www.truecaller.com', label: 'Truecaller', external: true },
  { href: 'https://www.12321.cn', label: '12321网络不良信息举报', external: true },
  { href: '/zh-CN/faq/', label: '常见问题', external: false },
  { href: '/zh-CN/about/', label: '关于我们', external: false },
  { href: '/zh-CN/contact/', label: '联系我们', external: false },
];
---

<footer class="relative bg-gray-900 text-gray-300 mt-auto overflow-hidden">
  <!-- 顶部渐变光带 -->
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-blue-500/60 to-transparent"></div>
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10">
      <!-- Brand -->
      <div class="lg:col-span-4">
        <div class="flex items-center gap-2.5 mb-5">
          <img src="/favicon-96.png" alt="号码标记清除网" width="40" height="40" class="w-10 h-10 rounded-xl shadow-lg shadow-blue-500/20" />
          <span class="text-xl font-bold text-white tracking-tight">号码标记清除网</span>
        </div>
        <p class="text-sm text-gray-400 mb-5 leading-relaxed">
          {L('号码标记清除网提供号码标记查询、号码标记清除、号码认证一站式服务，聚合中国信通院、360、腾讯、华为、Truecaller等官方入口。查询免费，不存储号码数据。', 'Number Marking Clear provides number marking check, removal and number authentication services, aggregating official channels including CAICT, 360, Tencent, Huawei and Truecaller. Free queries, no phone data stored.')}
        </p>
        <div class="flex flex-wrap gap-2 mb-5">
          <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 rounded-full px-3 py-1">
            <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>查询免费
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs text-blue-400 bg-blue-500/10 border border-blue-500/20 rounded-full px-3 py-1">
            <span class="w-1.5 h-1.5 bg-blue-400 rounded-full"></span>不存储号码数据
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs text-violet-400 bg-violet-500/10 border border-violet-500/20 rounded-full px-3 py-1">
            <span class="w-1.5 h-1.5 bg-violet-400 rounded-full"></span>官方渠道
          </span>
        </div>
        <div class="text-xs text-gray-500 leading-relaxed space-y-1">
          <p>严禁利用本站从事骚扰、诈骗或其他违法行为。</p>
          <p>内容仅作信息参考，不构成法律或商业建议。</p>
        </div>
      </div>

      <!-- Tools -->
      <div class="lg:col-span-3">
        <h3 class="text-white font-semibold mb-4 text-sm tracking-wide uppercase">{L('核心工具', 'Tools')}</h3>
        <ul class="space-y-2.5 text-sm">
          {toolLinks.map((l) => (
            <li>
              <a
                href={l.href}
                class="group inline-flex items-center gap-1.5 text-gray-400 hover:text-white transition-colors"
                target={l.external ? '_blank' : undefined}
                rel={l.external ? 'noopener noreferrer' : undefined}
              >
                <span class="w-1 h-1 rounded-full bg-gray-600 group-hover:bg-blue-400 transition-colors"></span>
                {L(l.label, l.label)}
                {l.external && <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Guides -->
      <div class="lg:col-span-2">
        <h3 class="text-white font-semibold mb-4 text-sm tracking-wide uppercase">{L('指南教程', 'Guides')}</h3>
        <ul class="space-y-2.5 text-sm">
          {guideLinks.map((l) => (
            <li><a href={l.href} class="text-gray-400 hover:text-white transition-colors">{L(l.label, l.label)}</a></li>
          ))}
        </ul>
        <div class="mt-6">
          <h3 class="text-white font-semibold mb-3 text-sm tracking-wide uppercase">{L('对比评测', 'Compare')}</h3>
          <ul class="space-y-2.5 text-sm">
            <li><a href="/zh-CN/compare/marking-platforms/" class="text-gray-400 hover:text-white transition-colors">{L('标记平台横向对比', 'Marking Platforms')}</a></li>
            <li><a href="/zh-CN/compare/auth-providers/" class="text-gray-400 hover:text-white transition-colors">{L('号码认证服务商对比', 'Auth Providers')}</a></li>
          </ul>
        </div>
      </div>

      <!-- Resources -->
      <div class="lg:col-span-3">
        <h3 class="text-white font-semibold mb-4 text-sm tracking-wide uppercase">{L('资源链接', 'Resources')}</h3>
        <ul class="space-y-2.5 text-sm">
          {resourceLinks.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-gray-400 hover:text-white transition-colors"
                target={l.external ? '_blank' : undefined}
                rel={l.external ? 'noopener noreferrer' : undefined}
              >{l.label}</a>
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <h3 class="text-white font-semibold mb-3 text-sm tracking-wide uppercase">{L('数据来源', 'Data Sources')}</h3>
          <ul class="space-y-2.5 text-sm">
            <li><a href="https://www.opene164.org.cn" class="text-gray-400 hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">信通院码号服务推进组</a></li>
            <li><a href="https://www.miit.gov.cn" class="text-gray-400 hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">工信部 (MIIT)</a></li>
            <li><a href="https://www.truecaller.com" class="text-gray-400 hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">Truecaller</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-800/80 mt-10 pt-7 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-500">
        © 2026 {L('号码标记清除网', 'Number Marking Clear')}. All rights reserved.
      </p>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
        <a href="/zh-CN/privacy/" class="text-gray-500 hover:text-white transition-colors">{L('隐私政策', 'Privacy')}</a>
        <a href="/zh-CN/cookie-policy/" class="text-gray-500 hover:text-white transition-colors">{L('Cookie 政策', 'Cookie Policy')}</a>
        <a href="/zh-CN/terms/" class="text-gray-500 hover:text-white transition-colors">{L('服务条款', 'Terms')}</a>
        <a href="/zh-CN/disclaimer/" class="text-gray-500 hover:text-white transition-colors">{L('免责声明', 'Disclaimer')}</a>
        <a href="/rss.xml" class="text-gray-500 hover:text-white transition-colors">RSS</a>
        <a href="/llms.txt" class="text-gray-500 hover:text-white transition-colors">llms.txt</a>
      </div>
    </div>
  </div>
</footer>

<!-- 回到顶部 -->
<button id="back-to-top" aria-label="回到顶部" class="fixed bottom-6 right-6 z-40 w-11 h-11 rounded-full bg-gradient-to-br from-blue-600 to-indigo-600 text-white shadow-xl shadow-blue-500/30 flex items-center justify-center opacity-0 translate-y-4 pointer-events-none transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/40">
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg>
</button>
