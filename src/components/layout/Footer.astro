---
interface Props {
  locale?: 'zh-CN' | 'en-US';
}

const { locale = 'zh-CN' } = Astro.props;
const L = (zh: string, en: string) => (locale === 'en-US' ? en : zh);

const toolLinks = [
  { href: '/zh-CN/tools/marking-clear/', label: '号码标记清除' },
  { href: '/zh-CN/tools/marking-check/', label: '号码标记自查' },
  { href: '/zh-CN/tools/attribution/', label: '号码归属地查询' },
  { href: '/zh-CN/tools/number-auth/', label: '号码认证服务' },
  { href: '/zh-CN/tools/legal-number-verify/', label: '法人号码核验' },
  { href: '/zh-CN/tools/registration-card/', label: '注册卡办理' },
  { href: '/zh-CN/tools/sim-cards/', label: '选号比价' },
];

const guideLinks = [
  { href: '/zh-CN/guide/what-is-number-marking/', label: '号码标记是什么' },
  { href: '/zh-CN/guide/how-to-check-marking/', label: '如何查询号码被标记' },
  { href: '/zh-CN/guide/how-to-clear-marking/', label: '如何清除号码标记' },
  { href: '/zh-CN/guide/landline-marking-clear/', label: '座机号码标记清除' },
  { href: '/zh-CN/guide/what-is-number-auth/', label: '号码认证是什么' },
];

const resourceLinks = [
  { href: 'https://www.opene164.org.cn', label: '中国信通院码号服务', external: true },
  { href: 'https://www.truecaller.com', label: 'Truecaller', external: true },
  { href: 'https://www.12321.cn', label: '12321网络不良信息举报', external: true },
  { href: '/zh-CN/faq/', label: '常见问题' },
  { href: '/zh-CN/about/', label: '关于我们' },
  { href: '/zh-CN/contact/', label: '联系我们' },
];
---

<footer class="bg-gray-900 text-gray-300 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="col-span-1">
        <div class="flex items-center space-x-2 mb-4">
          <div class="w-9 h-9 bg-gradient-to-br from-blue-600 to-indigo-700 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-sm">清</span>
          </div>
          <span class="text-xl font-bold text-white">号码标记清除网</span>
        </div>
        <p class="text-sm text-gray-400 mb-4">
          {L('号码标记清除网提供号码标记查询、号码标记清除、号码认证一站式服务，聚合中国信通院、360、腾讯、华为、Truecaller等官方入口。查询免费，不存储号码数据。', 'Number Marking Clear provides number marking check, removal and number authentication services, aggregating official channels including CAICT, 360, Tencent, Huawei and Truecaller. Free queries, no phone data stored.')}
        </p>
        <div class="text-xs text-gray-500 leading-relaxed">
          <p>严禁利用本站从事骚扰、诈骗或其他违法行为。</p>
          <p>内容仅作信息参考，不构成法律或商业建议。</p>
        </div>
      </div>

      <!-- Tools -->
      <div>
        <h3 class="text-white font-semibold mb-4">{L('核心工具', 'Tools')}</h3>
        <ul class="space-y-2 text-sm">
          {toolLinks.map((l) => (
            <li><a href={l.href} class="hover:text-white transition-colors">{L(l.label, l.label)}</a></li>
          ))}
        </ul>
      </div>

      <!-- Guides -->
      <div>
        <h3 class="text-white font-semibold mb-4">{L('指南教程', 'Guides')}</h3>
        <ul class="space-y-2 text-sm">
          {guideLinks.map((l) => (
            <li><a href={l.href} class="hover:text-white transition-colors">{L(l.label, l.label)}</a></li>
          ))}
        </ul>
        <div class="mt-6">
          <h3 class="text-white font-semibold mb-3">{L('对比评测', 'Compare')}</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/zh-CN/compare/marking-platforms/" class="hover:text-white transition-colors">{L('标记平台横向对比', 'Marking Platforms')}</a></li>
            <li><a href="/zh-CN/compare/auth-providers/" class="hover:text-white transition-colors">{L('号码认证服务商对比', 'Auth Providers')}</a></li>
          </ul>
        </div>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-white font-semibold mb-4">{L('资源链接', 'Resources')}</h3>
        <ul class="space-y-2 text-sm">
          {resourceLinks.map((l) => (
            <li>
              <a href={l.href} class="hover:text-white transition-colors" target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined}>{l.label}</a>
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <h3 class="text-white font-semibold mb-3">{L('数据来源', 'Data Sources')}</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="https://www.opene164.org.cn" class="hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">信通院码号服务推进组</a></li>
            <li><a href="https://www.miit.gov.cn" class="hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">工信部 (MIIT)</a></li>
            <li><a href="https://www.truecaller.com" class="hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">Truecaller</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-500">
        © 2026 {L('号码标记清除网', 'Number Marking Clear')}. All rights reserved.
      </p>
      <div class="flex flex-wrap space-x-6 text-sm">
        <a href="/zh-CN/privacy/" class="text-gray-500 hover:text-white transition-colors">{L('隐私政策', 'Privacy')}</a>
        <a href="/zh-CN/terms/" class="text-gray-500 hover:text-white transition-colors">{L('服务条款', 'Terms')}</a>
        <a href="/zh-CN/disclaimer/" class="text-gray-500 hover:text-white transition-colors">{L('免责声明', 'Disclaimer')}</a>
        <a href="/rss.xml" class="text-gray-500 hover:text-white transition-colors">RSS</a>
        <a href="/llms.txt" class="text-gray-500 hover:text-white transition-colors">llms.txt</a>
      </div>
    </div>
  </div>
</footer>