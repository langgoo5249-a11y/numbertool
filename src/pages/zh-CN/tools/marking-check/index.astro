---
import MainLayout from '@layouts/MainLayout.astro';
import CallPreview from '@components/CallPreview.astro';
import { CLEAR_LINK, EXTERNAL_PROPS } from '@lib/links';
---

<MainLayout
  title="号码标记自查 - 全平台标记状态查询"
  description="输入手机号或座机号，一键查询360、腾讯、华为、百度、泰迪熊、Truecaller等平台的标记状态。查询免费，不存储数据。"
  keywords="号码标记自查,号码标记查询,手机号码标记,座机号码标记,360标记,腾讯标记,华为标记"
>
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <nav class="flex items-center space-x-2 text-sm text-gray-500 mb-4" aria-label="面包屑导航">
        <a href="/zh-CN/" class="hover:text-gray-700">首页</a>
        <span>/</span>
        <a href="/zh-CN/tools/" class="hover:text-gray-700">核心工具</a>
        <span>/</span>
        <span class="text-gray-900">号码标记自查</span>
      </nav>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">号码标记自查</h1>
      <p class="text-gray-600">查询您的手机号码或座机号在各大平台的标记状态</p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Tool Section -->
    <div class="relative overflow-hidden bg-gradient-to-br from-blue-600 to-indigo-600 rounded-2xl p-8 text-white mb-8 shadow-xl shadow-blue-500/20">
      <div class="absolute -top-16 -right-16 w-48 h-48 bg-cyan-400/25 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative">
        <div class="flex items-center space-x-3 mb-6">
          <div class="w-10 h-10 bg-white/15 backdrop-blur-sm rounded-lg flex items-center justify-center border border-white/20">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <h2 class="text-xl font-semibold">输入号码进行查询</h2>
        </div>

        <div class="space-y-4">
          <div>
            <span class="block text-sm font-medium text-blue-100 mb-2">选择号码类型</span>
            <div class="flex flex-wrap gap-3">
              <label class="flex items-center gap-2 cursor-pointer bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 hover:bg-white/15 transition-colors">
                <input type="radio" name="numberType" value="mobile" checked class="text-blue-600 focus:ring-blue-500 accent-white" />
                <span class="text-white text-sm">手机号码</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 hover:bg-white/15 transition-colors">
                <input type="radio" name="numberType" value="landline" class="text-blue-600 focus:ring-blue-500 accent-white" />
                <span class="text-white text-sm">座机号码</span>
              </label>
            </div>
          </div>

          <div>
            <label for="phoneNumber" class="block text-sm font-medium text-blue-100 mb-2">输入号码</label>
            <input
              type="text"
              id="phoneNumber"
              placeholder="请输入手机号码或座机号"
              class="w-full px-4 py-3.5 rounded-xl bg-white/95 border border-white/30 text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-white/60 focus:bg-white transition-all"
            />
            <p class="mt-2 text-sm text-blue-200">
              座机号码查询时请带区号，如：010-xxxxxxxx
            </p>
          </div>

          <a href={CLEAR_LINK} {...EXTERNAL_PROPS} class="group block w-full text-center bg-white text-blue-700 py-3.5 rounded-xl font-bold shadow-lg hover:shadow-2xl hover:-translate-y-0.5 transition-all">
            <span class="inline-flex items-center gap-2">
              开始查询并进入快速清除
              <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5-5 5M6 12h12"/></svg>
            </span>
          </a>
          <p class="text-xs text-blue-200 text-center">点击后进入官方授权快速通道，可查询标记状态并直接提交清除申诉</p>
        </div>
      </div>
    </div>

    <!-- Supported Platforms -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 mb-8">
      <h2 class="text-xl font-semibold mb-6">支持查询的平台</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {['360手机卫士', '腾讯手机管家', '华为终端', '百度号码认证', '泰迪熊移动', 'Truecaller'].map((platform) => (
          <div class="flex items-center space-x-2 p-3 bg-gray-50 rounded-lg">
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-sm text-gray-700">{platform}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- 来电标记状态示意（CSS 绘制示意，非真实截图） -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 mb-8 reveal">
      <h2 class="text-xl font-semibold mb-2">被标记的来电长什么样？</h2>
      <p class="text-sm text-gray-500 mb-8">两种典型来电界面示意（CSS 绘制示意图，非真实截图）：左为被误标号码，右为完成认证的企业号码。</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 items-start justify-items-center">
        <div class="text-center">
          <CallPreview number="138 0013 8000" label="骚扰电话（疑似营销）" variant="marked" />
          <p class="mt-4 text-sm text-red-600 font-medium">❌ 被标记：接听率暴跌，客户流失</p>
          <p class="mt-1 text-xs text-gray-500">红标提示 + 标记人数，用户直接拒接</p>
        </div>
        <div class="text-center">
          <CallPreview number="138 0013 8000" label="××科技有限公司" variant="verified" />
          <p class="mt-4 text-sm text-emerald-600 font-medium">✅ 已认证：显示企业名，接听率提升</p>
          <p class="mt-1 text-xs text-gray-500">认证名片从源头降低误标概率</p>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap gap-3 justify-center">
        <a href={CLEAR_LINK} {...EXTERNAL_PROPS} class="group inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl font-semibold shadow-lg shadow-blue-500/25 hover:shadow-xl hover:-translate-y-0.5 transition-all">
          查询并清除我的标记
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5-5 5M6 12h12"/></svg>
        </a>
        <a href="/zh-CN/tools/number-auth/" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-blue-600 border border-blue-200 rounded-xl font-semibold hover:border-blue-400 transition-all">了解号码认证</a>
      </div>
    </div>

    <!-- How to Use -->
    <div class="bg-blue-50 rounded-xl border border-blue-100 p-8 mb-8">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">使用说明</h2>
      <ol class="space-y-3 text-gray-700">
        <li class="flex items-start space-x-3">
          <span class="flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-sm font-medium">1</span>
          <span>选择号码类型（手机或座机）</span>
        </li>
        <li class="flex items-start space-x-3">
          <span class="flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-sm font-medium">2</span>
          <span>输入完整的手机号码或带区号的座机号</span>
        </li>
        <li class="flex items-start space-x-3">
          <span class="flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-sm font-medium">3</span>
          <span>点击查询，系统将聚合展示各平台标记状态</span>
        </li>
        <li class="flex items-start space-x-3">
          <span class="flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-sm font-medium">4</span>
          <span>根据查询结果，选择对应平台的清除入口进行申诉</span>
        </li>
      </ol>
    </div>

    <!-- Privacy Notice -->
    <div class="bg-green-50 rounded-xl border border-green-100 p-6">
      <div class="flex items-start space-x-3">
        <svg class="w-6 h-6 text-green-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
        <div>
          <h3 class="font-semibold text-green-900 mb-1">隐私保护声明</h3>
          <p class="text-sm text-green-800">
            本站不会存储您输入的号码信息，所有查询请求仅在浏览器端处理。我们建议您通过官方渠道进行查询和申诉，以确保个人信息安全。
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "如何查询号码被标记？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "号码标记查询可通过号码标记清除网的号码标记自查工具完成。输入手机号码后，系统会聚合展示该号码在360手机卫士、腾讯手机管家、华为手机、搜狗号码通、百度号码认证等平台上的标记状态。您可以看到号码是否被标记为骚扰电话、推销、诈骗等类别。查询完全免费，无需注册。"
        }
      },
      {
        "@type": "Question",
        "name": "号码标记查询需要收费吗？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "号码标记查询完全免费。中国信通院码号服务推进组（opene164.org.cn）和各官方平台的申诉流程均不收取费用。请谨防第三方付费查询骗局。"
        }
      }
    ]
  }
  </script>
</MainLayout>
