---
import MainLayout from '@layouts/MainLayout.astro';
import { SITE_URL } from '@lib/seo';

export async function getStaticPaths() {
  return [
    { params: { slug: '2026-number-false-marking-guide' } },
    { params: { slug: '2026-phone-manufacturer-local-marking-database-clear-guide' } },
    { params: { slug: '2026-ai-marking-algorithm-rules-guide' } },
    { params: { slug: '2026-recycled-number-false-marking-guide' } },
    { params: { slug: '2026-enterprise-400-number-marking-clear-guide' } },
    { params: { slug: '2026-high-frequency-outbound-number-marking-solution' } },
    { params: { slug: '2026-number-marking-appeal-rejected-solutions' } },
    { params: { slug: '2026-phone-marking-removal-complete-guide' } },
    { params: { slug: '2026-phone-marking-recurrence-after-clearance' } },
    { params: { slug: '2026-carrier-network-interception-guide' } },
  ];
}

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const posts: Record<string, { title: string; date: string; excerpt: string; content: string; tags: string[] }> = {
  '2026-number-false-marking-guide': {
    title: '没打过电话却被标成骚扰电话？号码误标真相与清除指南',
    date: '2026-08-28',
    excerpt: '号码误标三大来源、YD/T 4980-2024申诉依据与清除顺序，公安热线被误标真实案例。',
    tags: ['号码误标', '申诉指南'],
    content: `
# 没打过电话却被标成骚扰电话？号码误标真相与清除指南

## 号码为什么会被误标？

### 三大误标来源

1. **用户手动标记**：其他用户误操作，将正常号码标记为骚扰电话
2. **AI算法误判**：智能标记系统基于算法自动判定，存在误判可能
3. **二次放号问题**：运营商回收号码重新发放，新号主继承了前任的标记历史

### YD/T 4980-2024标准解读

根据《通信短信息和语音呼叫服务管理规范》（YD/T 4980-2024），号码标记申诉需遵循以下流程...

## 清除标记的操作步骤

1. 查询号码在各平台的标记状态
2. 准备申诉材料（身份证明、号码归属证明）
3. 逐一提交申诉至各标记平台
4. 等待审核（通常1-3个工作日）

## 注意事项

- 公安热线等特殊号码被误标，需提供官方证明文件
- 企业号码需提供营业执照等资质证明
- 申诉过程中保持电话畅通，配合平台核实

*本文最后更新于2026年8月28日*
    `,
  },
};

const post = posts[slug] || null;
---

{post ? (
  <MainLayout
    title={`${post.title} | 号码通查`}
    description={post.excerpt}
    keywords={post.tags.join(',')}
  >
    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <header class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{post.title}</h1>
        <div class="flex items-center space-x-4 text-sm text-gray-500">
          <time datetime={post.date}>{post.date}</time>
          <span>·</span>
          {post.tags.map(tag => (
            <span key={tag} class="px-2 py-1 bg-blue-50 text-blue-600 rounded-full text-xs">{tag}</span>
          ))}
        </div>
      </header>
      <div class="prose prose-lg max-w-none" dangerouslySetInnerHTML={{ __html: post.content }} />
    </article>
  </MainLayout>
) : (
  <MainLayout title="文章未找到 | 号码通查">
    <div class="max-w-4xl mx-auto px-4 py-12 text-center">
      <h1 class="text-2xl font-bold text-gray-900 mb-4">文章未找到</h1>
      <p class="text-gray-600">抱歉，您要查找的文章不存在或已被删除。</p>
      <a href="/zh-CN/blog/" class="inline-block mt-6 text-blue-600 hover:text-blue-700">返回博客列表</a>
    </div>
  </MainLayout>
)}