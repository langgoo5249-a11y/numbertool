---
import MainLayout from '@layouts/MainLayout.astro';
import { SITE_URL } from '@lib/seo';
import { marked } from 'marked';
import { ALL_POSTS, getPostBySlug } from '@lib/blog-posts';

// 配置 marked：启用表格、链接等 GFM 特性
marked.setOptions({ gfm: true, breaks: true });

export async function getStaticPaths() {
  return Object.keys(ALL_POSTS).map((slug) => ({
    params: { slug },
    props: { post: ALL_POSTS[slug] },
  }));
}

interface Props {
  slug: string;
  post: { title: string; date: string; excerpt: string; content: string; tags: string[] };
}

const { post } = Astro.props;

// 兜底：即使 props 未注入，也从路径中解析 slug
const resolvedPost = post ?? getPostBySlug(Astro.url.pathname.split('/').filter(Boolean).pop() ?? '');

// 将 markdown 渲染为 HTML
const contentHtml = resolvedPost ? marked.parse(resolvedPost.content) : '';

// 文章 JSON-LD 结构化数据
const articleSchema = resolvedPost
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: resolvedPost.title,
      description: resolvedPost.excerpt,
      author: { '@type': 'Organization', name: '号码标记清除网' },
      datePublished: resolvedPost.date,
      dateModified: resolvedPost.date,
      publisher: { '@type': 'Organization', name: '号码标记清除网' },
      mainEntityOfPage: `${SITE_URL}/zh-CN/blog/${Astro.url.pathname.split('/').filter(Boolean).pop()}/`,
    }
  : null;
---

{resolvedPost ? (
  <MainLayout
    title={resolvedPost.title}
    description={resolvedPost.excerpt}
    keywords={resolvedPost.tags.join(',')}
    buildSchema="none"
    type="article"
    datePublished={resolvedPost.date}
    dateModified={resolvedPost.date}
    extraSchema={articleSchema ? [articleSchema] : []}
  >
    <div class="bg-white border-b border-gray-200">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <nav class="text-sm text-gray-500 mb-4 flex items-center gap-2">
          <a href="/zh-CN/" class="hover:text-gray-700">首页</a>
          <span>/</span>
          <a href="/zh-CN/blog/" class="hover:text-gray-700">号码百科</a>
        </nav>
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 leading-tight mb-4">{resolvedPost.title}</h1>
        <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500">
          <time datetime={resolvedPost.date}>{resolvedPost.date}</time>
          <span>·</span>
          <span>专业编辑 · 号码标记清除网</span>
          <div class="flex gap-2">
            {resolvedPost.tags.map((tag) => (
              <span key={tag} class="px-2 py-0.5 bg-blue-50 text-blue-600 rounded-full text-xs">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="prose prose-lg max-w-none bg-white rounded-xl border border-gray-200 p-6 md:p-10" set:html={contentHtml} />
    </article>
  </MainLayout>
) : (
  <MainLayout title="文章未找到">
    <div class="max-w-4xl mx-auto px-4 py-12 text-center">
      <h1 class="text-2xl font-bold text-gray-900 mb-4">文章未找到</h1>
      <p class="text-gray-600">抱歉，您要查找的文章不存在或已被删除。</p>
      <a href="/zh-CN/blog/" class="inline-block mt-6 text-blue-600 hover:text-blue-700">返回号码百科</a>
    </div>
  </MainLayout>
)