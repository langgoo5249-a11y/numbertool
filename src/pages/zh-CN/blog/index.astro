  { slug: '2026-recycled-number-false-marking-guide', title: '二次号码被标记骚扰电话怎么办？新办手机号误标清除', date: '2026-07-07', excerpt: '新办手机号误标记清除全攻略，工信部"二次号码焕新"服务解读。', tags: ['二手号', '新办号码'] },
  { slug: '2026-enterprise-95-96-number-marking-clear-guide', title: '95/96号码被标记怎么清除？企业95/96号段标记清除方案', date: '2026-07-03', excerpt: '95/96企业短号被标记怎么处理？分平台申诉与号码认证组合方案。', tags: ['95号码', '96号码', '企业号码'] },
