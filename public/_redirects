# Cloudflare Pages 重定向规则
# 规则按顺序匹配，具体路径写在通配规则之前。
# 目的：旧版 Astro 站（上线于 /zh-CN/ 路径下）的地址 301 到新站对应页面，保留已积累的收录与权重。

# ---- 旧站首页 ----
/zh-CN/                                     /                                        301
/zh-CN                                      /                                        301

# ---- 旧站博客（16 篇）→ 新站号码百科逐篇对应 ----
# 用 :slug 占位符保留每一篇文章的独立地址，避免长尾收录被统一打到首页
/zh-CN/blog/                                /blog/                                   301
/zh-CN/blog                                 /blog/                                   301
/zh-CN/blog/:slug/                          /blog/:slug.html                         301
/zh-CN/blog/:slug                           /blog/:slug.html                         301

# ---- 旧站 FAQ → 新站常见问题 ----
/zh-CN/faq/                                 /faq.html                                301
/zh-CN/faq                                  /faq.html                                301

# ---- 旧站工具页 → 新站工具页 ----
/zh-CN/tools/marking-check/                 /tools/marking-check.html                301
/zh-CN/tools/marking-clear/                 /tools/marking-clear.html                301
/zh-CN/tools/legal-number-verify/           /tools/legal-number-verify.html          301
/zh-CN/tools/attribution/                   /tools/attribution.html                  301

# ---- 旧站指南页 → 内容最接近的新页面 ----
/zh-CN/guide/landline-marking-clear/        /blog/2026-landline-marking-removal-guide.html   301
/zh-CN/guide/how-to-check-marking/          /guide/how-to-check.html                 301
/zh-CN/guide/how-to-clear-marking/          /guide/how-to-check.html                 301
/zh-CN/guide/                               /guide/how-to-check.html                 301

# ---- 旧站其余页面 ----
/zh-CN/about/                               /about.html                              301
/zh-CN/tools/                               /                                        301
/zh-CN/tools/*                              /                                        301
/zh-CN/guide/*                              /guide/how-to-check.html                 301
/zh-CN/*                                    /                                        301
/en-US/*                                    /                                        301

# ---- 历史文件 ----
/sitemap-index.xml                          /sitemap.xml                             301
